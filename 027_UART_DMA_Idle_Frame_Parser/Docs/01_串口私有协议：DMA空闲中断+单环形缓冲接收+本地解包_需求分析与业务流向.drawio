  <diagram id="uart-requirements-flow" name="需求分析与业务流向">
    <mxGraphModel dx="3709" dy="2160" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3840" pageHeight="2160" background="#F6F8FB" math="0" shadow="0">
